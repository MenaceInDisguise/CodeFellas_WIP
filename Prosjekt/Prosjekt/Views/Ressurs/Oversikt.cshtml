@using Prosjekt.Models.ModelView
@model List<RessursViewModel>

@{
    ViewData["Title"] = "Oversikt over ressurser";
}

<h1>Oversikt over ressurser</h1>
<div class="row">
    <div class="col-md-7">
        <table class="table table-striped table-hover mt-3">
            <thead>
                <tr>
                    <th>Navn</th>
                    <th>Beskrivelse</th>
                    <th>Kategori</th>
                    <th>Antall</th>
                    <th>Handlinger</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Navn</td>
                            <td>@item.Beskrivelse</td>
                            <td>@item.Kategori</td>
                            <td>@item.Antall</td>
                            <td>
                                <a asp-controller="Ressurs" asp-action="Edit" asp-route-navn="@item.Navn" class="btn btn-sm btn-warning">Rediger</a>

                                <form asp-controller="Ressurs" asp-action="Delete" asp-route-navn="@item.Navn" method="post" style="display:inline;" onsubmit="return confirm('Er du sikker på at du vil slette @item.Navn?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Slett</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-muted">Ingen ressurser registrert ennå.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-5">
        <div id="oversiktKart" style="height: 500px;"></div>
    </div>
</div>

@section Scripts {
    <script>
        var ressurser = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        var kart = L.map('oversiktKart').setView([58.1467, 7.9956], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(kart);

        // 1. Gruppér ressursene etter posisjon (Latitude, Longitude)
        var grupperteRessurser = {};

        if (ressurser && ressurser.length > 0) {
            ressurser.forEach(function(r) {
                var lat = parseFloat(r.Latitude);
                var lng = parseFloat(r.Longitude);

                if (isNaN(lat) || isNaN(lng)) return;

                // Lager en unik nøkkel basert på koordinatene (rundet av litt for å unngå precision-feil)
                var nokkel = lat.toFixed(6) + ',' + lng.toFixed(6);

                if (!grupperteRessurser[nokkel]) {
                    grupperteRessurser[nokkel] = {
                        lat: lat,
                        lng: lng,
                        items: []
                    };
                }
                grupperteRessurser[nokkel].items.push(r);
            });
        }

        var bounds = [];

        // 2. Opprett én markør per unike koordinat
        Object.keys(grupperteRessurser).forEach(function(nokkel) {
            var gruppe = grupperteRessurser[nokkel];

            // Bygg innholdet for alle ressurser på denne posisjonen
            var innhold = '<div style="max-height: 200px; overflow-y: auto;">';
            
            gruppe.items.forEach(function(r, index) {
                innhold += `<b>${r.Navn}</b><br>Kategori: ${r.Kategori}<br>Antall: ${r.Antall}`;
                
                // Legg til en skillelinje dersom det er flere ressurser på samme punkt
                if (index < gruppe.items.length - 1) {
                    innhold += '<hr style="margin: 6px 0; border: 0; border-top: 1px solid #ccc;">';
                }
            });

            innhold += '</div>';

            // Dersom det er flere enn 1 ressurs på punktet, bruker vi bindPopup slik at man kan scrolle/lese alt enkelt
            var marker = L.marker([gruppe.lat, gruppe.lng]);

            if (gruppe.items.length > 1) {
                marker.bindPopup(innhold);
                // Valgfritt: Vis et lite tooltip når man hovrer over som forteller at det er flere ressurser der
                marker.bindTooltip(`${gruppe.items.length} ressurser på dette stedet (klikk for detaljer)`);
            } else {
                marker.bindTooltip(innhold);
            }

            marker.addTo(kart);
            bounds.push([gruppe.lat, gruppe.lng]);
        });

        // 3. Tilpass kartvisningen
        if (bounds.length > 0) {
            kart.fitBounds(bounds, { padding: [30, 30], maxZoom: 13 });
        }
    </script>
}