@model IEnumerable<Prosjekt.Models.ModelView.GeoChangeViewModel>

@{
    ViewData["Title"] = "Hjem - Geografiske Hendelser";
}

<!-- CSS for å tvinge innholdet helt ut i kantene (Fjerner ASP.NET standard marger) -->
<style>
    main {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-bottom: 0 !important;
    }
</style>

<!-- Kartbeholder som dekker hele det tilgjengelige området -->
<div id="homeMap" style="height: calc(100vh - 80px); width: 100%; margin: 0; padding: 0;"></div>

@section Scripts {
    <!-- Legg til Leaflet CSS for at kartet skal vises korrekt -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('homeMap').setView([58.1467, 7.9956], 11);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        var positions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        var bounds = [];

        if (positions && positions.length > 0) {
            positions.forEach(function(pos) {
                var lat = parseFloat(pos.Latitude);
                var lng = parseFloat(pos.Longitude);
                var radius = parseFloat(pos.Radius);
                
                var changeTypesText = (pos.SelectedChangeTypes && pos.SelectedChangeTypes.length > 0) 
                    ? pos.SelectedChangeTypes.join(', ') 
                    : 'Ingen angitt';

                if (!isNaN(lat) && !isNaN(lng)) {
                    L.marker([lat, lng])
                        .bindPopup(`
                            <b>${pos.Description}</b><br>
                            <b>Endringstype:</b> ${changeTypesText}<br>
                            <b>Radius:</b> ${radius} m
                        `)
                        .addTo(map);
                    
                    L.circle([lat, lng], {
                        radius: radius,
                        color: '#3388ff',
                        fillColor: '#3388ff',
                        fillOpacity: 0.2
                    }).addTo(map);

                    bounds.push([lat, lng]);
                }
            });
        }

        if (bounds.length > 0) {
            map.fitBounds(bounds, { padding: [30, 30], maxZoom: 13 });
        }

        // Fikser grå fliser og oppdaterer kartet umiddelbart ved innlasting
        setTimeout(function() {
            map.invalidateSize();
        }, 200);

        // Gjør at kartet dynamisk og sømløst tilpasser seg hvis brukeren endrer vindusstørrelsen
        const mapContainer = document.getElementById('homeMap');
        const resizeObserver = new ResizeObserver(() => {
            map.invalidateSize();
        });
        resizeObserver.observe(mapContainer);
    </script>
}