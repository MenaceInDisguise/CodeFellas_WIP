@model List<Prosjekt.Models.ModelView.PositionViewModel>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<h2>Oversikt over registrerte geografiske hendelser</h2>

<div class="row">
    <!-- Liste på venstre side -->
    <div class="col-md-4">
        <div class="list-group">
            @foreach (var pos in Model)
            {
                <div class="list-group-item mb-2">
                    <h5>@pos.Description</h5>
                    <p class="mb-1"><strong>Breddegrad:</strong> @pos.Latitude</p>
                    <p class="mb-1"><strong>Lengdegrad:</strong> @pos.Longitude</p>
                    <p class="mb-0"><strong>Radius:</strong> @pos.Radius m</p>
                </div>
            }
        </div>
    </div>

    <!-- Kart på høyre side -->
    <div class="col-md-8">
        <div id="overviewMap" style="height: 500px; width: 100%;"></div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('overviewMap').setView([58.1467, 7.9956], 11);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        var positions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        var bounds = [];

        positions.forEach(function(pos) {
            var lat = parseFloat(pos.Latitude);
            var lng = parseFloat(pos.Longitude);
            var radius = parseFloat(pos.Radius);

            if (!isNaN(lat) && !isNaN(lng)) {
                L.marker([lat, lng])
                    .bindPopup(`<b>${pos.Description}</b><br>Radius: ${radius} m`)
                    .addTo(map);

                L.circle([lat, lng], {
                    radius: radius,
                    color: '#3388ff',
                    fillColor: '#3388ff',
                    fillOpacity: 0.2
                }).addTo(map);

                bounds.push([lat, lng]);
            }
        });

        
        if (bounds.length > 0) {
            // maxZoom forhindrer at kartet zoomer altfor langt inn når det bare er 1 punkt
            map.fitBounds(bounds, {
                padding: [30, 30],
                maxZoom: 13
            });
        }

        // Tvinger kartet til å beregne størrelsen på nytt dersom det blir rendret skjult
        setTimeout(function() {
            map.invalidateSize();
        }, 200);
    </script>
}