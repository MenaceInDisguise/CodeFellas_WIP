<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Prosjekt</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Prosjekt.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-dark glass-navbar">
            <div class="container-fluid">
                <a class="navbar-brand text-white fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Prosjekt</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-area="" asp-controller="Home" asp-action="Privacy">Personvern</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid flex-grow-1 d-flex flex-column">
        <div class="row flex-grow-1">
            <!-- Venstremeny -->
            <aside class="col-md-3 col-lg-2 border-end pe-3 mb-4 d-flex flex-column" style="min-height: calc(100vh - 160px);">
                <ul class="nav nav-pills flex-column gap-2">
                    <strong>Registrering</strong>
                    <li class="nav-item">
                        <a class="nav-link text-dark border" asp-area="" asp-controller="Ressurs" asp-action="Index">Registrer ressurs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark border" asp-area="" asp-controller="Behov" asp-action="Index">Registrer Behov</a>
                    </li>
                    <strong>Kriseinformasjon</strong>
                    <li class="nav-item">
                        <a class="nav-link text-dark border" asp-area="" asp-controller="Kriseinformasjon" asp-action="Index">Kriseinformasjon</a>
                    </li>
                </ul>

                <!-- Innstillinger helt nederst uten boks -->
                <div class="mt-auto">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Innstillinger" asp-action="Index"><strong>Innstillinger</strong></a>
                </div>
            </aside>

            <!-- Hovedinnhold -->
            <main role="main" class="col-md-9 col-lg-10 pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Prosjekt - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
