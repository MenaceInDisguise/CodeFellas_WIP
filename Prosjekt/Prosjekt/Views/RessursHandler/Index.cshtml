@using Prosjekt.Models.ModelView
@model List<RessursViewModel>
@{
    ViewData["Title"] = "Ordbok Oversikt";
}

<a asp-controller="RessursHandler" asp-action="Create" class="btn btn-success">Opprett Ny Ressurs</a>
<br /><br />

<table class="table">
    <tr>
        <th>Navn</th>
        <th>Beskrivelse</th>
        <th>Antall</th>
        <th>Handlinger</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Navn</td>
            <td>@item.Beskrivelse</td>
            <td>@item.Antall</td>
            <td>
                <!-- Lenke til Rediger-skjemaet -->
                <a asp-controller="RessursHandler" asp-action="Edit" asp-route-navn="@item.Navn">Rediger</a> |
                
                <!-- Knapp til å slette fra ordboken -->
                <form asp-controller="RessursHandler" asp-action="Delete" asp-route-navn="@item.Navn" method="post" style="display:inline" onsubmit="return confirm('Slette?');">
                    <button type="submit">Slett</button>
                </form>
            </td>
        </tr>
    }
</table>