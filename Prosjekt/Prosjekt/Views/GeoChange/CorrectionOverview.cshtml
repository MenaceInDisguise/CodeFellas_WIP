@model List<Prosjekt.Models.ModelView.GeoChangeViewModel>

@{
    ViewData["Title"] = "Oversikt over geografiske hendelser";
}

<h2 class="mb-4">Oversikt over registrerte geografiske hendelser</h2>

<div class="row">
    <!-- Liste på venstre side -->
    <div class="col-lg-4 col-md-5 mb-4">
        <div class="list-group shadow-sm" style="max-height: 65vh; overflow-y: auto;">
            @foreach (var pos in Model)
            {
                <div class="list-group-item mb-2 rounded border">
                    <h5 class="text-primary">@pos.Description</h5>
                    <p class="mb-1 small">
                        <strong>Endringstyper:</strong> 
                        <span class="badge bg-info text-dark">@(pos.SelectedChangeTypes != null && pos.SelectedChangeTypes.Any() ? string.Join(", ", pos.SelectedChangeTypes) : "Ingen angitt")</span>
                    </p>
                    <p class="mb-1 small"><strong>Breddegrad:</strong> @pos.Latitude</p>
                    <p class="mb-1 small"><strong>Lengdegrad:</strong> @pos.Longitude</p>
                    <p class="mb-0 small"><strong>Radius:</strong> @pos.Radius m</p>
                </div>
            }
        </div>
    </div>

    <!-- Kart på høyre side -->
    <div class="col-lg-8 col-md-7">
        <div id="overviewMap" class="shadow-sm" style="height: 65vh; min-height: 400px; width: 100%; border-radius: 8px;"></div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('overviewMap').setView([58.1467, 7.9956], 11);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        var positions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        var bounds = [];

        positions.forEach(function(pos) {
            var lat = parseFloat(pos.Latitude);
            var lng = parseFloat(pos.Longitude);
            var radius = parseFloat(pos.Radius);
            
            var changeTypesText = (pos.SelectedChangeTypes && pos.SelectedChangeTypes.length > 0) 
                ? pos.SelectedChangeTypes.join(', ') 
                : 'Ingen angitt';

            if (!isNaN(lat) && !isNaN(lng)) {
                L.marker([lat, lng])
                    .bindPopup(`
                        <b>${pos.Description}</b><br>
                        <b>Endringstype:</b> ${changeTypesText}<br>
                        <b>Radius:</b> ${radius} m
                    `)
                    .addTo(map);
                L.circle([lat, lng], {
                    radius: radius,
                    color: '#3388ff',
                    fillColor: '#3388ff',
                    fillOpacity: 0.2
                }).addTo(map);

                bounds.push([lat, lng]);
            }
        });

        if (bounds.length > 0) {
            map.fitBounds(bounds, { padding: [30, 30], maxZoom: 13 });
        }

        setTimeout(function() { map.invalidateSize(); }, 200);
    </script>
}