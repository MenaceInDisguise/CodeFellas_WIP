@using Prosjekt.Models.ModelView
@model RessursViewModel
@{
    ViewData["Title"] = "Endre Ressurs";
}
<form asp-controller="RessursHandler" asp-action="Edit" method="post">
    <div>
        <label asp-for="Navn">Navn</label>
        <input asp-for="Navn" value="@Model.Navn" />
    </div>
    <div>
        <label asp-for="Beskrivelse">Beskrivelse</label>
        <input asp-for="Beskrivelse" value="@Model.Beskrivelse" />
    </div>
    <div>
        <label asp-for="Antall">Antall</label>
        <input asp-for="Antall" value="@Model.Antall" type="number" />
    </div>
    
    <!-- Tar vare på det opprinnelige navnet som en ID-nøkkel for ordboken -->
    <input type="hidden" name="opprinneligNavn" value="@Model.Navn" />
    
    <button type="submit">Save</button>
</form>