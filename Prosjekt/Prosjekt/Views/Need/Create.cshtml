@using Prosjekt.Models.ModelView
@model NeedViewModel

@{
    ViewData["Title"] = "Nytt behov opprettet";
}

@* Color per importance *@
@functions {
    string GetColor(Importance v) => v switch
    {
        Importance.High => "#dc3545",
        Importance.Medium => "#ffc107",
        _ => "#198754"
    };
}

<h1>Nytt behov opprettet</h1>
<hr />

<div class="row mb-3">
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <p><strong>Navn:</strong> @Model.Name</p>
            <p><strong>Beskrivelse:</strong> @Model.Description</p>
            <p><strong>Antall som trengs:</strong> @Model.Total</p>
            <p>
                <strong>Viktighet:</strong>
                <span class="badge" style="@($"background-color: {GetColor(Model.Importance)}")">@Model.Importance</span>
            </p>
            <p class="mb-0"><strong>Posisjon:</strong> @Model.Latitude, @Model.Longitude</p>
        </div>
    </div>
    <div class="col-md-6">
        <div id="kvitteringBehovKart" style="height: 280px;"></div>
    </div>
</div>

<a asp-controller="Need" asp-action="Index" class="btn btn-secondary">Opprett enda et behov</a>
<a asp-controller="Need" asp-action="Overview" class="btn btn-primary">Gå til oversikten</a>

@section Scripts {
    <script>
        var lat = parseFloat('@Model.Latitude');
        var lng = parseFloat('@Model.Longitude');
        var viktighetNummer = @((int)Model.Importance);

        if (!isNaN(lat) && !isNaN(lng)) {
            var kart = L.map('kvitteringBehovKart').setView([lat, lng], 14);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(kart);

            function getIkon(fargeNavn) {
                return new L.Icon({
                    iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${fargeNavn}.png`,
                    shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                    iconSize: [25, 41],
                    iconAnchor: [12, 41],
                    popupAnchor: [1, -34],
                    shadowSize: [41, 41]
                });
            }

            var ikoner = {
                0: getIkon('green'),
                1: getIkon('gold'),
                2: getIkon('red')
            };

            var valgtIkon = ikoner[viktighetNummer] || ikoner[0];

            L.marker([lat, lng], { icon: valgtIkon }).addTo(kart);
        }
    </script>
}