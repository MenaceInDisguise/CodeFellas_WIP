@model List<Prosjekt.Models.ModelView.PositionViewModel>

<h2>Posisjon registrert</h2>

<div class="row">
    <!-- Venstre side: Boks satt til 450px med intern scrollbar om det blir mange elementer -->
    <div class="col-md-4" style="max-height: 450px; overflow-y: auto;">
        @foreach (var position in Model)
        {
            <div class="mb-3 p-2 border-bottom">
                <p class="mb-1"><strong>Breddegrader:</strong> @position.Latitude</p>
                <p class="mb-1"><strong>Breddegrader:</strong> @position.Longitude</p>
                <p class="mb-1"><strong>Beskrivelse:</strong> @position.Description</p>
            </div>
        }
    </div>

    <!-- Høyre side: Kart satt til nøyaktig 450px -->
    <div class="col-md-8">
        <div id="map" style="height: 450px;"></div>
    </div>
</div>

@section Scripts {
    <script>
        var positions = @Json.Serialize(Model);

        var map = L.map('map').setView([58.1467, 7.9956], 12);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        if (positions && positions.length > 0) {
            var bounds = [];

            positions.forEach(function(position) {
                // Håndterer både camelCase/PascalCase og komma/punktum
                var rawLat = String(position.latitude ?? position.Latitude ?? "").replace(',', '.');
                var rawLng = String(position.longitude ?? position.Longitude ?? "").replace(',', '.');

                var lat = parseFloat(rawLat);
                var lng = parseFloat(rawLng);
                var desc = position.description ?? position.Description ?? "";

                if (!isNaN(lat) && !isNaN(lng)) {
                    // Tegn pinnen umiddelbart
                    var marker = L.marker([lat, lng]).addTo(map);
                    marker.bindPopup(`<b>${desc}</b>`);

                    bounds.push([lat, lng]);

                    // Valgfritt: Hent adresse i bakgrunnen uten å stoppe koden
                    var url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`;
                    fetch(url)
                        .then(response => response.json())
                        .then(data => {
                            if (data && data.display_name) {
                                marker.setPopupContent(`<b>${desc}</b><br>${data.display_name}`);
                            }
                        })
                        .catch(err => console.log("Adressefeil:", err));
                }
            });

            // Zoomer ut/inn slik at ALLE pinnene vises i bildet samtidig
            if (bounds.length > 0) {
                map.fitBounds(bounds, { padding: [40, 40] });
            }
        }
    </script>
}