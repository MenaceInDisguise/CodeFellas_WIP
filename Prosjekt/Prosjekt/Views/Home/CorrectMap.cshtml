@model Prosjekt.Models.PositionModel

<h2>Register a Position</h2>

<form asp-action="CorrectMap" method="post">
    <div class="form-group">
        <label for="latitude">Latitude</label>
        <input type="text" id="latitude" name="Latitude" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label for="longitude">Longitude</label>
        <input type="text" id="longitude" name="Longitude" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="DEscription" class="form-control"></textarea>
    </div>
    <button type"submit" class"btn btn-primary">Submit</button>
</form>

<div id="map" style="height: 400px;"></div>

@section Scripts {
    <script>
        //Initialize the map
        console.log("map div:", document.getElementById('map'));
        var map = L.map('map').setView([51.505, -0.09], 15);

        //Add OpenStreetMap tile layer
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributers'
        }).addTo(map);

        var currentMarker = null;

        // Handle map click event
        map.on('click', function(e) {
            // Get clicked position
            var lat = e.latlng.lat;
            var lng = e.latlng.lng;

            // Set the latitude and longitude fields in the form
            document.getElementById('latitude').value = lat;
            document.getElementById('longitude').value = lng;
            
            // Remove previous marker
            if (currentMarker) {
                map.removeLayer(currentMarker);
            }
            // Add marker to the map
            currentMarker = L.marker([lat, lng]).addTo(map);
        });

    </script>
}