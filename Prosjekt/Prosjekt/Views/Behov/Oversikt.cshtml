@using Prosjekt.Models.ModelView
@model List<BehovViewModel>

@{
    ViewData["Title"] = "Oversikt over behov";
}
@functions 
{
    string Farge(Viktighet v) => v switch
    {
        Viktighet.Høy => "#dc3545",     // rød
        Viktighet.Middels => "#fd7e14", // oransje
        _ => "#ffc107"                  // gul
    };
}

<h1>Oversikt over behov</h1>

<div class="row">
    <div class="col-md-7">
        <table class="table table-striped table-hover mt-3">
            <thead>
                <tr>
                    <th>Navn</th>
                    <th>Beskrivelse</th>
                    <th>Antall som trengs</th>
                    <th>Viktighet</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Navn</td>
                            <td>@item.Beskrivelse</td>
                            <td>@item.Totalt</td>
                            <td>
                                <span class="badge" style="@($"background-color: {Farge(item.Viktighet)}")">@item.Viktighet</span>
                            </td>
                            <td>
                                <a asp-controller="Behov" asp-action="Edit" asp-route-navn="@item.Navn" class="btn btn-sm btn-warning">Rediger</a>

                                <form asp-controller="Behov" asp-action="Delete" asp-route-navn="@item.Navn" method="post" style="display:inline;" onsubmit="return confirm('Er du sikker på at du vil slette @item.Navn?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Slett</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-muted">Ingen behov registrert ennå.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-5">
        <div id="oversiktBehovKart" style="height: 500px;">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var behov = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        var kart = L.map('oversiktBehovKart').setView([58.1467, 7.9956], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(kart);

        var bounds = [];

        var fargeFor = { 0: '#ffc107', 1: '#fd7e14', 2: '#dc3545'};

        behov.forEach(function(b) {
            var lat = parseFloat(b.Latitude);
            var lng = parseFloat(b.Longitude);
            if (isNaN(lat) || isNaN(lng)) return;

            var farge = fargeFor[b.Viktighet] || '#ffc107';
            L.circleMarker([lat, lng], {
                radius: 9,
                color: '#333',
                weight: 1,
                fillColor: farge,
                fillOpacity: 0.9
            })
            .bindTooltip(`<b>${b.Navn}</b><br>Antall: ${b.Totalt}`)
            .addTo(kart);

            bounds.push([lat, lng]);
        });

        if (bounds.length > 0) {
            kart.fitBounds(bounds, { padding: [30, 30], maxZoom: 13 });
        }

        console.log(behov);
    </script>
}