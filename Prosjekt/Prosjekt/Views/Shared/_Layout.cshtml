<!DOCTYPE html>
<html lang="en">
<link rel="stylesheet" href="https://jsdelivr.net">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Prosjekt</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Prosjekt.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://jsdelivr.net">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Prosjekt</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
    <!-- Venstrejustert tomrom eller menyvalg om ønskelig -->
    <div></div>

    <!-- Høyrejustert bruker- og varslingsseksjon -->
    <div class="d-flex align-items-center gap-3 ms-auto">
        <!-- Varslingsbjelle -->
        <button class="btn btn-link text-dark position-relative p-1 border-0">
            <i class="bi bi-bell fs-5"></i>
            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
        </button>

        <!-- Beredskapsstatus og Brukerikon -->
        <div class="d-flex align-items-center gap-2 border rounded-pill px-3 py-1 bg-light">
            <i class="bi bi-shield-check text-primary"></i>
            <span class="small fw-semibold text-secondary">Beredskapsnivå: Normal</span>
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold ms-2 shadow-sm" style="width: 35px; height: 35px; font-size: 14px; background-color: #0d6efd !important;">
                DEMO
            </div>
        </div>
    </div>
</div>

                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid flex-grow-1 d-flex flex-column">
        <div class="row flex-grow-1">
            <!-- Venstremeny -->
        <aside class="col-md-3 col-lg-2 border-end pe-3 mb-4 d-flex flex-column" style="min-height: calc(100vh - 160px);">
            <div class="nav flex-column nav-pills gap-1">
                <!-- Min side -->
                <a class="nav-link active d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-person-workspace"></i> Min side
                </a>

                <!-- Registrer ressurs -->
                <a class="nav-link text-dark d-flex align-items-center gap-2" asp-area="" asp-controller="Ressurs" asp-action="Registrer">
                    <i class="bi bi-plus-circle"></i> Registrer ressurs
                </a>

                <!-- Kriseinformasjon -->
                <a class="nav-link text-dark d-flex align-items-center gap-2" asp-area="" asp-controller="Kriseinformasjon" asp-action="Index">
                    <i class="bi bi-exclamation-triangle"></i> Kriseinformasjon
                </a>

                <!-- Innstillinger -->
                <a class="nav-link text-dark d-flex align-items-center gap-2" asp-area="" asp-controller="Innstillinger" asp-action="Index">
                    <i class="bi bi-gear"></i> Innstillinger
                </a>
            </div>
        </aside>


            <!-- Hovedinnhold -->
            <main role="main" class="col-md-9 col-lg-10 pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
        &copy; 2026 - Prosjekt - <a asp-area="" asp-controller="Home" asp-action="Personvern">Personvern</a>

        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
